# ==============================================================================
# 1. 运行入口与设备
# ------------------------------------------------------------------------------
# scripts/infer_pcd.py、scripts/batch_infer_pcd.py 和 scripts/http_infer_pcd.py
# 都会自动加载当前目录或仓库根目录的 .env；已存在的系统环境变量优先。
# CLI：命令行参数 > 环境变量/.env > 脚本默认值。
# HTTP：请求只上传点云文件；建模策略、GPU 和本地路径全部来自服务进程环境。
# 路径规则：
# - Docker Compose 运行时，NKSR_CHECKPOINTS_DIR 填宿主机 checkpoint 目录，Compose 会挂载到 /workspace/checkpoints:ro。
# - 容器内服务进程读取的 NKSR_CHECKPOINTS_DIR 固定为 /workspace/checkpoints。
# - 宿主机直接运行脚本时，NKSR_CHECKPOINTS_DIR 直接按宿主机路径读取。

# DEVICE：torch device。多 GPU HTTP 部署时建议用 CUDA_VISIBLE_DEVICES 选物理卡，
# 进程内仍写 cuda:0，例如 CUDA_VISIBLE_DEVICES=1 DEVICE=cuda:0。
DEVICE=cuda:0

# PYTORCH_CUDA_ALLOC_CONF：CUDA allocator 配置。大点云 OOM 日志提示碎片化时可启用。
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ==============================================================================
# 2. 预训练配置与输入字段
# ------------------------------------------------------------------------------
# NKSR_CONFIG：内置预训练配置名，不是权重文件路径。
#   ks            通用 kitchen-sink 模型，依赖法向，适合先跑通场景级输入。
#   snet          单物体模型，依赖法向，细节更强，适合干净物体级点云。
#   snet-wonormal 单物体无法向版本，适合没有可靠法向的输入；当前默认。
NKSR_CONFIG=snet-wonormal

# NKSR_CHECKPOINTS_DIR：checkpoint 目录。Docker 会挂载到 /workspace/checkpoints:ro。
# 文件名需与 NKSR_CONFIG 对应：ks.pth、snet-n3k-wnormal.pth、snet-n3k-wonormal.pth。
# 下载地址：
#   ks.pth
#   https://huggingface.co/heiwang1997/nksr-checkpoints/resolve/main/checkpoints/ks.pth
#   snet-n3k-wnormal.pth
#   https://huggingface.co/heiwang1997/nksr-checkpoints/resolve/main/checkpoints/snet-n3k-wnormal.pth
#   snet-n3k-wonormal.pth
#   https://huggingface.co/heiwang1997/nksr-checkpoints/resolve/main/checkpoints/snet-n3k-wonormal.pth
NKSR_CHECKPOINTS_DIR=./checkpoints

# NKSR_INPUT_MODE：重建方向信息来源。
#   auto     优先用输入法向列；没有法向时再尝试 sensor 列；仍没有时不使用方向信息。
#   normal   必须从 NKSR_NORMAL_COLS 读取法向。
#   sensor   必须从 NKSR_SENSOR_COLS 读取传感器位置，并据此定向。
#   estimate 估计法向；由 NKSR_ESTIMATE_KNN 和 NKSR_ESTIMATE_ORIENT 控制。
NKSR_INPUT_MODE=auto

# 输入点云字段名。PLY/PCD 字段不一致时改这里；HTTP 请求不能覆盖这些本地解析策略。
NKSR_XYZ_COLS=x,y,z
NKSR_NORMAL_COLS=normal_x,normal_y,normal_z
NKSR_SENSOR_COLS=sensor_x,sensor_y,sensor_z
NKSR_COLOR_COLS=red,green,blue

# ==============================================================================
# 3. 坐标对齐、导出坐标系与统计文件
# ------------------------------------------------------------------------------
# NKSR_OBB_LOCK_AXIS：导出坐标系下的 OBB 对齐方式。
#   auto 默认，锁定 NKSR_OUTPUT_UP_AXIS 指定的竖轴。
#   none 不做 OBB 旋转归一化。
#   z    锁定 z 轴，只在 xy 平面内做 2D OBB 对齐。
#   y/x  锁定对应轴，在另外两个轴平面内对齐。
#   pca  按 PCA 主轴做 3D OBB 对齐。
NKSR_OBB_LOCK_AXIS=auto

# NKSR_OUTPUT_UP_AXIS：导出网格上方向。
#   y  默认，把 z-up 结果转为 y-up，适合 three.js 常见场景。
#   z  保持 z-up。
NKSR_OUTPUT_UP_AXIS=y

# NKSR_WRITE_STATS：是否输出同名 .stats.json；HTTP zip 内也会包含该文件。
NKSR_WRITE_STATS=true

# ==============================================================================
# 4. 网格简化与输出体积
# ------------------------------------------------------------------------------
# NKSR_SIMPLIFY_METHOD：减面方式。
#   none       不减面；此时 NKSR_FACE_RATIO 不会实际生效。
#   auto       优先使用 quadric，依赖可用库自动选择 fallback。
#   quadric    二次误差减面，通常质量更好。
#   clustering 聚类减面，通常更快但几何质量更粗。
NKSR_SIMPLIFY_METHOD=auto

# NKSR_FACE_RATIO：目标面数比例，范围 (0, 1]。
# 只有 NKSR_SIMPLIFY_METHOD 不是 none 且此值 < 1.0 时才会执行减面。
NKSR_FACE_RATIO=0.1

# ==============================================================================
# 5. 重建细节、体素尺寸与分块
# ------------------------------------------------------------------------------
# NKSR_DETAIL_LEVEL：重建细节等级，范围 [0, 1]；自适应分块时会逐 chunk 生效。
# 设置 NKSR_VOXEL_SIZE 后会忽略 detail level。
NKSR_DETAIL_LEVEL=1

# NKSR_VOXEL_SIZE：显式指定最细体素尺寸；为空时由 detail level 等策略决定。
# 注意：不能和 NKSR_MAX_CHUNK_EXTENT/NKSR_MAX_CHUNK_INPUT_EXTENT 同时使用；可和点数分块一起使用。
NKSR_VOXEL_SIZE=

# NKSR_MAX_CHUNK_POINTS：单个 chunk 最大输入点数；<=0 表示不按点数分块。
# 默认不分块，优先保证单货物 mesh 完整性；显存不足时再显式设置该值。
NKSR_MAX_CHUNK_POINTS=0

# NKSR_MAX_CHUNK_EXTENT：单个 chunk 最大空间范围；为空或 <=0 表示不按空间范围分块。
NKSR_MAX_CHUNK_EXTENT=

# NKSR_MAX_CHUNK_INPUT_EXTENT：额外空间范围限制；为空或 <=0 表示不启用。
# 如果同时设置 MAX_CHUNK_EXTENT 和 MAX_CHUNK_INPUT_EXTENT，实际使用二者较小值。
NKSR_MAX_CHUNK_INPUT_EXTENT=

# NKSR_CHUNK_OVERLAP_RATIO：分块重叠比例，范围 [0, 0.49]。
NKSR_CHUNK_OVERLAP_RATIO=0.05

# NKSR_CHUNK_TMP_DEVICE：已完成 chunk 的临时存储设备。
# cpu 更省显存；cuda 可能更快但显存压力更大。
NKSR_CHUNK_TMP_DEVICE=cpu

# NKSR_MAX_INPUT_EXTENT：整体输入最大空间范围；<=0 表示关闭保护。
# 超过该范围会在重建前拒绝处理，避免异常大场景拖垮服务。
NKSR_MAX_INPUT_EXTENT=200.0

# ==============================================================================
# 6. 输入过滤、法向估计与网格提取
# ------------------------------------------------------------------------------
# NKSR_OUTLIER_QUANTILE：坐标外点对称裁剪分位数，范围 [0, 0.5)；0 表示不裁剪。
NKSR_OUTLIER_QUANTILE=0.0

# NKSR_MIN_FILTERED_POINTS：过滤后最少点数；低于该值视为输入无效。
NKSR_MIN_FILTERED_POINTS=1000

# NKSR_ESTIMATE_KNN：input_mode=estimate 或需要估计法向时使用的 KNN 数量。
NKSR_ESTIMATE_KNN=64

# NKSR_ESTIMATE_ORIENT：估计法向后的朝向策略。
#   centroid  默认，朝向相对点云中心定向。
#   none      不额外定向。
NKSR_ESTIMATE_ORIENT=centroid

# NKSR_DROP_THRESHOLD_DEG：sensor 模式下丢弃法向夹角异常点的阈值，单位度。
NKSR_DROP_THRESHOLD_DEG=85.0

# NKSR_MISE_ITER：Dual mesh MISE 提取迭代次数；越大越细，耗时和显存越高。
NKSR_MISE_ITER=1

# NKSR_GRID_UPSAMPLE：网格提取上采样倍率；越大越细，耗时和内存越高。
NKSR_GRID_UPSAMPLE=1

# NKSR_EXTRACT_ON_CPU：是否把 field/network 移到 CPU 后提取网格。
# true 更省显存但更慢；GPU 显存不稳时可开启。
NKSR_EXTRACT_ON_CPU=false

# NKSR_TEXTURE_MODE：颜色纹理导出策略。
#   auto 默认，有颜色字段时导出顶点颜色；多 chunk 也保留颜色。
#   off  跳过颜色纹理场，降低显存/内存峰值。
NKSR_TEXTURE_MODE=auto

# ==============================================================================
# 7. 求解器与高级性能参数
# ------------------------------------------------------------------------------
# 一般不需要调整；除非你明确在排查速度、收敛或大场景稳定性。
NKSR_APPROX_KERNEL_GRAD=false
NKSR_SOLVER_MAX_ITER=2000
NKSR_SOLVER_TOL=1.0e-5
NKSR_NYSTROM_MIN_DEPTH=100
NKSR_RECONSTRUCT_ATTEMPTS=5
NKSR_FUSED_MODE=true

# ==============================================================================
# 8. 批量 CLI 配置
# ------------------------------------------------------------------------------
# 仅 scripts/batch_infer_pcd.py 使用。
NKSR_BATCH_EXTENSIONS=.pcd,.ply
NKSR_SKIP_EXISTING=true

# ==============================================================================
# 9. HTTP 服务配置
# ------------------------------------------------------------------------------
# HTTP_HOST/HTTP_PORT：服务监听地址和端口。
HTTP_HOST=0.0.0.0
HTTP_PORT=8012

# HTTP_AUTH_TOKEN：为空则不鉴权；非空时 /v1/reconstruct 需要 Authorization: Bearer <token>。
HTTP_AUTH_TOKEN=

# ==============================================================================
# 10. Docker 镜像构建配置
# ------------------------------------------------------------------------------
# 这些变量只影响 docker compose build，不改变运行时建模语义。
# 默认 CUDA 12.4.1 基础镜像匹配 NVIDIA Driver 550.x / CUDA 12.4 服务器。
BASE_IMAGE=nvidia/cuda:12.4.1-devel-ubuntu22.04
APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
PIP_TRUSTED_HOST=mirrors.aliyun.com
UV_INSTALL_URL=https://astral.sh/uv/install.sh
TORCH_CUDA_ARCH_LIST=8.6
MAX_JOBS=4
